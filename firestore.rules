
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // Allow public reads ONLY for the theme document for login page styling.
      // All other reads, and all writes, still require authentication.
      allow read: if (request.path == /databases/$(database)/documents/settings/theme) || request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
