
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // Allow public reads for the theme document for login page styling, and for the entities collection for the signup page.
      // All other reads, and all writes, still require authentication.
      allow read: if (request.path == /databases/$(database)/documents/settings/theme) ||
                     (request.path.size() >= 5 && request.path[4] == 'entities') ||
                     request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
