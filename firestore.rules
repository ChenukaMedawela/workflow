
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // This rule allows any authenticated user to read and write to all documents.
    // It's good for development but should be replaced with more secure rules
    // for a production environment.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
